---
---
<label for="photo">Sua foto</label>
<p class="upload-hint">Envie uma foto sua de rosto — é a que vamos usar na montagem.</p>
<label class="upload-box" id="upload-box" for="photo">
  <div class="upload-empty" id="upload-empty">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M12 4l-4 4M12 4l4 4"/><path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
    <span>Toque para escolher a foto</span>
  </div>
  <img class="upload-preview" id="upload-preview" alt="Prévia da sua foto">
</label>
<input type="file" id="photo" name="photo" accept="image/*" style="display:none" required>

<style>
  .upload-hint{
    font-size:12px;
    opacity:.65;
    margin:-2px 0 8px;
    font-weight:500;
  }
  .upload-box{
    display:flex; align-items:center; justify-content:center;
    min-height: 140px;
    border: 2px dashed rgba(255,255,255,0.25);
    border-radius: 14px;
    background: rgba(0,0,0,0.2);
    cursor:pointer;
    overflow:hidden;
    margin-top: 10px;
    transition: border-color .15s;
  }
  .upload-box:hover{ border-color: rgba(255,201,60,0.5); }
  .upload-box.has-file{ border-style:solid; border-color: var(--dourado); }
  .upload-empty{
    display:flex; flex-direction:column; align-items:center; gap:8px;
    padding:22px; text-align:center; font-size:13px; font-weight:700;
    color: rgba(255,248,236,0.6);
  }
  .upload-empty svg{ width:26px; height:26px; color: var(--dourado); }
  .upload-preview{ display:none; width:100%; max-height:260px; object-fit:cover; }
  .upload-box.has-file .upload-empty{ display:none; }
  .upload-box.has-file .upload-preview{ display:block; }
</style>
