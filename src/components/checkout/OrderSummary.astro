---
import { PRICE_LABEL, LOGO_SRC } from '../../config/site';

const garantias = [
  'Montagem feita à mão pela nossa equipe',
  'Pagamento único, sem assinatura',
  'Fica pronta no mesmo dia',
];
---
<section class="step" data-step="resumo" hidden>
  <header class="step-topo">
    <p class="olho">Passo 1 de 3</p>
    <h1>Confira seu pedido</h1>
  </header>

  <div class="pedido">
    <div class="pedido-item">
      <img class="pedido-thumb" src={LOGO_SRC} alt="" aria-hidden="true">
      <div>
        <strong>Foto com o Companheiro</strong>
        <span>Montagem personalizada, feita com a sua foto</span>
      </div>
    </div>

    <div class="pedido-linha pedido-total">
      <span>Total</span>
      <span class="pedido-valor">{PRICE_LABEL}</span>
    </div>
  </div>

  <ul class="garantias">
    {garantias.map((g) => <li>{g}</li>)}
  </ul>

  <button type="button" class="pay-btn" data-ir="dados">Continuar</button>
  <p class="lock-note">Pagamento via Pix, processado pela Cakto</p>
</section>

<style>
  .pedido{
    background: rgba(0,0,0,0.22);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 16px;
  }
  .pedido-item{ display:flex; gap:12px; align-items:center; }
  .pedido-thumb{
    width:52px; height:52px; border-radius:10px; object-fit:cover;
    flex-shrink:0; border:2px solid rgba(255,201,60,0.5);
  }
  .pedido-item strong{ display:block; font-size:15px; }
  .pedido-item span{ display:block; font-size:12.5px; opacity:.7; margin-top:2px; }
  .pedido-linha{
    display:flex; justify-content:space-between; align-items:center;
    margin-top:16px; padding-top:14px;
    border-top:1px dashed rgba(255,255,255,0.2);
    font-size:14px; font-weight:700;
  }
  .pedido-valor{ font-family:'Anton', sans-serif; font-size:26px; color: var(--dourado); }
  .garantias{ list-style:none; margin:18px 0 4px; display:grid; gap:9px; }
  .garantias li{
    display:flex; gap:9px; align-items:flex-start;
    font-size:13px; opacity:.85; line-height:1.45;
  }
  .garantias li::before{
    content:'✓'; color: var(--dourado); font-weight:800; flex-shrink:0;
  }
</style>
