---
import CtaButton from '../CtaButton.astro';
import { CHECKOUT_PATH, PRICE_SHORT_LABEL } from '../../config/site';
---
<header class="hero" id="hero">
  <div class="wrap hero-inner">
    <div class="id-card">
      <div class="id-card-photo">
        <img src="/dps.png" alt="Depois: montagem personalizada criada com IA ao lado do Lula">
        <span class="id-card-badge">Gerado por IA</span>
        <span class="id-card-mini"><img src="/bf97f3da-d6f3-4f30-8997-0c8cbe43ab2e.png" alt="Antes: foto original enviada pelo cliente"></span>
        <span class="id-card-banner">AO LADO DO LULA</span>
      </div>
      <div class="id-card-captions">
        <span>A foto que você manda</span>
        <span>O que você recebe</span>
      </div>
      <div class="id-card-bottom">
        <span>Montagem com IA</span>
        <span class="id-card-price">R$ 13</span>
      </div>
    </div>

    <div class="hero-content">
      <span class="eyebrow">🔥 Montagem personalizada com IA</span>
      <h1>JÁ IMAGINOU TER UMA FOTO SUA <span class="amarelo">AO LADO DO LULA?</span></h1>
      <p class="sub">Você manda uma foto pelo WhatsApp. A gente cria uma <strong>montagem personalizada com IA</strong> e entrega o arquivo pronto para você guardar, postar ou compartilhar.</p>

      <div class="price-tag">
        <span class="label">Por apenas</span>
        <span class="value"><span>R$</span> 13,00</span>
      </div>

      <div class="hero-cta">
        <CtaButton href={CHECKOUT_PATH} arrow>Quero minha foto por {PRICE_SHORT_LABEL}</CtaButton>
        <p class="btn-sub">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.7 7-6.3-3.9-6.3 3.9 1.7-7L2 9.2l7.1-.6z"/></svg>
          Pagamento único • Sem mensalidade
        </p>
        <div class="trust-row">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg> Pagamento único</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Atendimento no WhatsApp</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg> Arquivo digital</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero{
    background:
      radial-gradient(120% 90% at 50% -10%, rgba(216,19,19,0.55) 0%, rgba(74,5,5,0) 60%),
      linear-gradient(180deg, var(--vermelho-escuro) 0%, var(--vermelho-escuro-2) 55%, var(--preto) 100%);
    padding: 32px 0 26px;
    text-align:center;
    overflow:hidden;
  }
  .hero::before{
    content:"";
    position:absolute; inset:0;
    background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    opacity:0.4;
    pointer-events:none;
  }
  .hero-inner{
    position:relative; z-index:1;
    display:flex;
    flex-direction:column;
    gap: 30px;
  }
  .hero :global(.eyebrow){ margin-bottom: 16px; animation: pulseGlow 2.2s ease-in-out infinite; }
  @keyframes pulseGlow{
    0%,100%{ box-shadow: 0 0 0 0 rgba(255,201,60,0.35); }
    50%{ box-shadow: 0 0 0 8px rgba(255,201,60,0); }
  }
  .hero h1{
    font-size: 32px;
    color: var(--branco-puro);
    margin-bottom: 14px;
  }
  .hero p.sub{
    font-size: 16px;
    color: var(--texto-claro);
    opacity: 0.92;
    max-width: 380px;
    margin: 0 auto 22px;
    font-weight: 500;
  }

  /* ---------- CARTÃO DA FOTO (hero) ---------- */
  .id-card{
    max-width: 380px;
    margin: 0 auto;
    background: var(--branco);
    color: var(--preto);
    border-radius: var(--radius);
    padding: 14px 14px 18px;
    box-shadow: 0 24px 50px rgba(0,0,0,0.35);
    text-align:left;
  }
  .id-card-photo{
    position:relative;
    border-radius: var(--radius-sm);
    overflow:hidden;
    aspect-ratio: 4/5;
  }
  .id-card-photo img{ width:100%; height:100%; object-fit:cover; }
  .id-card-badge{
    position:absolute; top:10px; right:10px; z-index:2;
    background: var(--vermelho-escuro);
    color: var(--dourado-2);
    font-size: 9.5px;
    font-weight:800;
    letter-spacing:0.5px;
    text-transform:uppercase;
    padding: 5px 10px;
    border-radius: 100px;
  }
  .id-card-mini{
    position:absolute; left:10px; bottom:26px; z-index:2;
    width: 60px; height:60px;
    border-radius: 10px;
    overflow:hidden;
    border: 3px solid var(--branco-puro);
    box-shadow: 0 8px 16px rgba(0,0,0,0.35);
  }
  .id-card-mini img{ width:100%; height:100%; object-fit:cover; }
  .id-card-banner{
    position:absolute; left:0; right:0; bottom:0; z-index:1;
    background: linear-gradient(90deg, var(--vermelho-vivo), var(--vermelho-vivo-2));
    color: var(--branco-puro);
    font-family:'Anton', sans-serif;
    font-size: 13px;
    letter-spacing: 0.4px;
    padding: 11px 14px 11px 82px;
  }
  .id-card-captions{
    display:flex;
    justify-content:space-between;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    color: #7a6a5a;
    padding: 12px 4px 10px;
  }
  .id-card-captions span:last-child{ text-align:right; }
  .id-card-bottom{
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-top: 1px dashed rgba(74,5,5,0.18);
    padding: 12px 4px 2px;
  }
  .id-card-bottom span:first-child{
    font-family:'Anton', sans-serif;
    font-size: 13px;
    letter-spacing:0.4px;
    color: var(--vermelho-escuro);
  }
  .id-card-price{
    font-family:'Anton', sans-serif;
    font-size: 20px;
    color: var(--vermelho-vivo);
  }

  .price-tag{
    display:inline-flex;
    flex-direction:column;
    align-items:center;
    gap:0;
    margin-bottom: 22px;
    background: rgba(0,0,0,0.2);
    border: 1px solid rgba(255,201,60,0.35);
    border-radius: 18px;
    padding: 12px 30px 14px;
  }
  .price-tag .label{
    font-size: 12.5px;
    font-weight:800;
    color: var(--dourado-2);
    text-transform:uppercase;
    letter-spacing:1.2px;
  }
  .price-tag .value{
    font-family:'Anton', sans-serif;
    font-size: 50px;
    color: var(--branco-puro);
    line-height:1;
    text-shadow: 0 4px 18px rgba(0,0,0,0.35);
  }
  .price-tag .value span{ font-size: 24px; vertical-align: 8px; color: var(--dourado); }
  .hero-cta{ max-width: 360px; margin: 0 auto; }

  .trust-row{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap: 8px 16px;
    margin-top: 18px;
  }
  .trust-row span{
    display:flex; align-items:center; gap:5px;
    font-size: 11.5px;
    font-weight: 700;
    color: rgba(255,233,214,0.7);
  }
  .trust-row svg{ width:14px; height:14px; color: var(--dourado); flex-shrink:0; }

  @media(min-width:900px){
    .hero{ padding: 60px 0 52px; }
    .hero-inner{
      display:grid;
      grid-template-columns: 1fr 1.05fr;
      align-items:center;
      gap: 60px;
      text-align:left;
    }
    .hero-content{ text-align:left; }
    .hero h1{ font-size: 50px; }
    .hero p.sub{ max-width: 480px; margin-left:0; margin-right:0; font-size: 19px; }
    .hero-cta{ margin: 0; }
    .hero-content .trust-row{ justify-content:flex-start; }
    .hero-content :global(.btn-sub){ justify-content:flex-start; }
    .price-tag .value{ font-size: 62px; }
    .id-card{ max-width: 420px; margin:0; }
  }
</style>
